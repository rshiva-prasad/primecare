SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx   # or legacy anon key. NEVER the service_role/secret key
APP_ENV=development
COOKIE_SECURE=false                           # true when served over HTTPS
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SUPABASE_TIMEOUT_SECONDS=10
AUTH_THROTTLE_ENABLED=true                    # login/register throttle; only test harnesses set false
